{
  "name": "app-gastos",
  "private": true,
  "version": "0.1.0",
  "description": "Gastos personales: presupuesto, gastos fijos y cuentas compartidas",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "construir": "node prototipo/construir.mjs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generar": "npm run generar --workspace @gastos/db",
    "prototipo": "node prototipo/construir.mjs",
    "prototipo:probar": "node prototipo/construir.mjs && node prototipo/humo.mjs",
    "prototipo:ver": "node prototipo/construir.mjs && node prototipo/vista-previa.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.19.12",
    "jsdom": "^30.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
